    "Q2 FY26",
    "Q3 FY26",
    "Q4 FY26",
    "Q1 FY27"
  ],
  "flatBandPct": 1.5,
  "sourceTagGuide": {
    "company-filing": "Number printed in the company's own results/PPT (a reported fact).",
    "mgmt-claim": "A figure management stated on the concall but did not file (guidance, a claim).",
    "derived": "Computed by the extractor from other reported numbers.",
    "inference": "Read between the lines - implied, not stated outright.",
    "unknown": "Source could not be established."
  },
